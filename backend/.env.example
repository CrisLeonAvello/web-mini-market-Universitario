# Configuración de la aplicación
# Copiar este archivo como .env y configurar los valores

# API
API_V1_STR=/api
PROJECT_NAME=Web Mini Market API

# Database
# SQLite (para desarrollo local rápido)
DATABASE_URL=sqlite:///./app.db

# MySQL (para desarrollo/producción)
# DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/minimarket_db

# PostgreSQL (alternativa)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/minimarket_db

# MySQL en Docker (docker-compose)
# DATABASE_URL=mysql+pymysql://root:rootpassword@mysql:3306/minimarket_db

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=994535848772-q0da4vlbl4spirmksdt1es2l1tuf2hbn.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
